---
interface Props {
  bg?: "black" | "white" | "surface" | "silver";
}

const bgMap = {
  black: "var(--color-black)",
  white: "var(--color-white)",
  surface: "var(--color-surface)",
  silver: "var(--color-silver)",
};

const { bg } = Astro.props;

const styles = bg
  ? `background-color: ${bgMap[bg]}; padding-block: var(--space-md);`
  : undefined;
---

<div class="wrapper" style={styles}>
  <slot />
</div>

<style>
  .wrapper {
    width: 100%;
    padding-inline: var(--container-pad-lg);
  }

  @media (max-width: 1024px) {
    .wrapper {
      padding-inline: var(--container-pad);
    }
  }
</style>
