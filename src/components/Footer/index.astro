---
import { Image } from "astro:assets";
import {
  FOOTER_SITE_LINKS,
  FOOTER_PRODUCT_LINKS,
  FOOTER_PARTNER_LINKS,
} from "@data/navigation";
import { COPYRIGHT } from "@constants/site";
import probellLogo from "@assets/icons/probell-logo.png";
---

<footer class="footer">
  <div>
    <div class="footer__grid">
      <!-- Column 1: Logo + tagline -->
      <div class="footer__brand">
        <a href="/" aria-label="Probell Nutrition home">
          <Image
            src={probellLogo}
            alt="Probell Nutrition"
            class="footer__logo"
            width={120}
            height={40}
            format="webp"
            loading="lazy"
          />
        </a>
      </div>

      <!-- Column 2: Links -->
      <nav class="footer__col" aria-label="Site links">
        <span class="label-text footer__col-heading">Links</span>
        {
          FOOTER_SITE_LINKS.map((link) => (
            <a href={link.href} class="footer__link">
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Column 3: Products -->
      <nav class="footer__col" aria-label="Product links">
        <span class="label-text footer__col-heading">Products</span>
        {
          FOOTER_PRODUCT_LINKS.map((link) => (
            <a href={link.href} class="footer__link">
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Column 4: Learn -->
      <nav class="footer__col" aria-label="Learn links">
        <span class="label-text footer__col-heading">Partners</span>
        {
          FOOTER_PARTNER_LINKS.map((link) => (
            <a href={link.href} class="footer__link">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="divider footer__divider"></div>

    <div class="footer__copyright">
      <span class="font-text footer__copy">
        {COPYRIGHT}
      </span>
      <div class="footer__legal-links">
        <a href="/legal" class="font-text footer__legal">Legal Policies</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-black-true);
    /* border-top: 1px solid var(--color-border); */
    padding: var(--space-lg);
  }

  .footer__grid {
    display: grid;
    /* 5th column (Follow Us) commented out above — reverts to 2fr 1fr 1fr 1fr 1fr when reintegrated */
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  /* Column 1 */
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer__logo {
    height: 40px;
    width: auto;
    display: block;
  }

  .footer__tagline {
    color: var(--color-grey);
  }

  /* Columns 2–4 */
  .footer__col {
    display: flex;
    flex-direction: column;
  }

  .footer__col-heading {
    color: var(--color-white);
    margin-bottom: var(--space-sm);
    display: flex;
    justify-content: center;
  }

  .footer__link {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: var(--text-label);
    color: var(--color-grey);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: var(--space-xs);
    transition: color var(--transition-fast);
  }

  .footer__link:hover {
    color: var(--color-red);
  }

  /* Social icons */
  .footer__socials {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .footer__social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    color: var(--color-white);
    text-decoration: none;
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base);
  }

  .footer__social-icon:hover {
    background-color: var(--color-red);
    border-color: var(--color-red);
  }

  /* Divider */
  .footer__divider {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  /* Copyright bar */
  .footer__copyright {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
  }

  .footer__copy {
    color: var(--color-grey);
  }

  .footer__legal-links {
    display: flex;
    gap: var(--space-md);
  }

  .footer__legal {
    color: var(--color-grey);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__legal:hover {
    color: var(--color-white);
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--space-lg);
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer__brand {
      grid-column: auto;
      align-items: center;
    }

    .footer__socials {
      justify-content: center;
    }

    .footer__copyright {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }
  }
</style>
