---
import { Image } from "astro:assets";
import partnerCta from "@assets/partners/partner-cta.jpg";
---

<div class="em__cta-section">
  <div class="em__cta-layout">
    <div class="em__cta-img">
      <Image
        src={partnerCta}
        alt="Probell products in a gym setting"
        width={780}
        height={580}
        format="webp"
        loading="lazy"
      />
    </div>
    <div class="em__cta-content">
      <h2 class="display-text em__cta-headline">
        Give your members what they've been asking for.
      </h2>
      <p class="em__cta-body font-text text-black">
        Probell is built for gyms that take their members seriously. Talk to us
        about wholesale pricing, margins, and display support.
      </p>
      <a href="/retail" class="btn-primary em__cta-btn">Request Wholesale Pricing</a>
    </div>
  </div>
</div>

<style>
  .em__cta-section {
    padding-top: var(--space-xl);
  }

  .em__cta-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  .em__cta-img :global(img) {
    width: 100%;
    height: 520px;
    object-fit: cover;
    display: block;
  }

  .em__cta-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .em__cta-headline {
    font-family: var(--font-display);
    /* h2 defaults to bold; Anton ships one weight, so keep it regular. */
    font-weight: 400;
    font-size: var(--text-statement-md);
    color: var(--color-black);
    line-height: 0.9;
    text-wrap: balance;
  }

  .em__cta-body {
    margin-top: var(--space-md);
  }

  .em__cta-btn {
    margin-top: var(--space-lg);
  }

  .em__cta-btn {
    width: min-content;
    white-space: nowrap;
  }

  .em__cta-body {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .em__cta-body {
      max-width: 42ch;
    }
  }

  @media (max-width: 768px) {
    .em__cta-section {
      padding-top: var(--space-lg);
    }

    .em__cta-layout {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .em__cta-img :global(img) {
      height: 320px;
    }

    .em__cta-btn {
      margin-top: var(--space-md);
    }
  }
</style>
