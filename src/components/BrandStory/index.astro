---
import BrandStatsBlock from "@components/BrandStory/BrandStatsBlock.astro";
import BrandCtaBlock from "@components/BrandStory/BrandCtaBlock.astro";
---

<section id="emotion">
  <h2 class="display-text em__headline">
    Just the product your serious members have been waiting for someone to
    stock.
  </h2>
  <BrandStatsBlock />
  <BrandCtaBlock />
</section>

<style>
  #emotion {
    background: var(--color-white);
    padding: var(--space-xl) 0;
  }

  .em__headline {
    font-family: var(--font-display);
    /* h2 defaults to bold; Anton ships one weight, so keep it regular. */
    font-weight: 400;
    font-size: var(--text-statement);
    line-height: 0.9;
    color: var(--color-black);
    text-align: center;
    max-width: 20ch;
    margin-inline: auto;
    text-wrap: balance;
    padding-bottom: var(--space-xl);
  }

  @media (max-width: 768px) {
    #emotion {
      padding: var(--space-lg) 0;
    }

    .em__headline {
      text-align: left;
      margin-inline: 0;
      padding-bottom: var(--space-lg);
    }
  }
</style>
