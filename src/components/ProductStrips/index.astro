---
import { PRODUCTS } from "@data/catalog";
import ProductStrip from "@components/ProductStrips/ProductStrip.astro";
---

<div class="ps">
  {PRODUCTS.filter((product) => product.status === "available").map((product) => (
    <ProductStrip product={product} />
  ))}
</div>

<style>
  .ps {
    display: flex;
    flex-direction: column;
  }
</style>
