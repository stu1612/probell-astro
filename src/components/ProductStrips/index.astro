---
import { PRODUCTS } from "@data/products";
import ProductStrip from "@components/ProductStrips/ProductStrip.astro";
---

<div class="ps">
  {PRODUCTS.map((product) => (
    <ProductStrip product={product} />
  ))}
</div>

<style>
  .ps {
    display: flex;
    flex-direction: column;
  }
</style>
