---
import { Image } from "astro:assets";
import type { Product } from "@data/catalog";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div
  class={`ps__strip${product.flip ? " ps__strip--flip" : ""}${product.overlay ? " ps__strip--overlay" : ""}`}
>
  {
    product.overlay ? (
      <div class="ps__bg">
        <Image
          src={product.image}
          alt={product.imageAlt}
          width={1600}
          height={1000}
          format="webp"
          loading="lazy"
        />
        <div class="ps__scrim" />
      </div>
    ) : (
      <div
        class={`ps__img-wrap${product.imageMuted ? " ps__img-wrap--muted" : ""}`}
      >
        <Image
          src={product.image}
          alt={product.imageAlt}
          width={1200}
          height={900}
          format="webp"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="ps__content">
    <span class="label-text label-text--red ps__eyebrow">
      <span class="ps__diamond">◆</span>
      {product.id} / {product.category}
    </span>
    <h3 class="display-text ps__name">
      {
        product.name.split("\n").map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </h3>
    <p class="ps__body font-text text-grey">{product.excerpt}</p>
    <div class="ps__stats">
      {
        product.stats.slice(0, 2).map((stat) => (
          <div class="ps__stat">
            <span class="display-text ps__stat-num">{stat.value}</span>
            <span class="label-text ps__stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>
    <a href={`/supplements/${product.slug}`} class="btn-skeleton ps__cta">
      See More →
    </a>
  </div>

  <span class="ps__ghost">{product.id}</span>
</div>

<style>
  .ps__strip {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 90vh;
    overflow: hidden;
  }

  .ps__strip + .ps__strip {
    margin-top: var(--space-xl);
  }

  .ps__strip--flip .ps__content {
    order: 2;
  }

  .ps__strip--flip .ps__img-wrap {
    order: 1;
  }

  .ps__img-wrap {
    order: 2;
    position: relative;
    height: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .ps__img-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow);
  }

  .ps__img-wrap--muted :global(img) {
    filter: grayscale(50%);
    opacity: 0.6;
  }

  .ps__strip:hover .ps__img-wrap :global(img) {
    transform: scale(1.05);
  }

  .ps__content {
    order: 1;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-lg);
    max-width: 640px;
    min-width: 0;
  }

  .ps__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .ps__diamond {
    font-size: 0.6em;
  }

  .ps__name {
    font-size: var(--text-statement);
    font-family: var(--font-display);
    color: var(--color-white);
    line-height: 0.95;
  }

  .ps__body {
    max-width: 46ch;
  }

  .ps__stats {
    display: flex;
    gap: var(--space-md);
  }

  .ps__stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-left: var(--space-sm);
    border-left: 2px solid var(--color-red);
  }

  .ps__stat-num {
    font-size: var(--text-product);
    color: var(--color-white);
    line-height: 1;
  }

  .ps__stat-label {
    color: var(--color-grey);
  }

  .ps__cta {
    background: transparent;
    color: var(--color-gold);
    border-color: var(--color-gold);
  }

  .ps__strip:hover .ps__cta {
    background: var(--color-gold);
    color: var(--color-black);
    border-color: var(--color-black);
  }

  .ps__ghost {
    position: absolute;
    z-index: 1;
    left: 0;
    bottom: -0.1em;
    font-family: var(--font-display);
    font-size: 28vw;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--color-grey);
    opacity: 0.08;
    pointer-events: none;
    user-select: none;
  }

  .ps__strip:hover .ps__ghost {
    opacity: 0.12;
  }

  .ps__strip--flip .ps__ghost,
  .ps__strip--overlay .ps__ghost {
    left: auto;
    right: 0;
  }

  /* Full-bleed image-background variant (strip 03) */
  .ps__strip--overlay {
    grid-template-columns: 1fr;
  }

  .ps__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .ps__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Zoom was tuned against athlete-walking.jpg's specific framing
       (crops out its dark doorframe margins) — retune if the source
       image for this strip changes. */
    transform: scale(1.45);
    transform-origin: center;
  }

  .ps__scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
  }

  .ps__strip--overlay .ps__content {
    grid-column: 1;
  }

  @media (max-width: 768px) {
    .ps__strip:not(.ps__strip--overlay) {
      grid-template-columns: 3fr 1fr;
    }

    .ps__strip--flip:not(.ps__strip--overlay) {
      grid-template-columns: 1fr 3fr;
    }

    .ps__content {
      padding: var(--space-md);
      max-width: none;
    }

    .ps__ghost {
      font-size: 45vw;
    }

    .ps__bg {
      filter: brightness(0.3);
    }
  }
</style>
