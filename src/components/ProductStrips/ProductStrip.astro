---
import { Image } from "astro:assets";
import type { Product } from "@data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class={`ps__strip${product.flip ? " ps__strip--flip" : ""}`}>
  {
    product.flip && (
      <div class="ps__img-wrap">
        <Image
          src={product.image}
          alt={product.imageAlt}
          width={900}
          height={700}
          format="webp"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="ps__content">
    <div class="ps__ghost">{product.id}</div>
    <span class={`label-text label-text--${product.labelAccent}`}
      >{product.label}</span
    >
    <h3 class="display-text ps__name">
      {
        product.name.split("\n").map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </h3>
    <p class="ps__body font-text text-grey">{product.body}</p>
    {
      product.stat && (
        <div class="ps__stat">
          <span class="display-text ps__stat-num">{product.stat.number}</span>
          <span class="label-text ps__stat-label">
            {product.stat.label.split("\n").map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </span>
        </div>
      )
    }
  </div>
  {
    !product.flip && (
      <div
        class={`ps__img-wrap${product.imageMuted ? " ps__img-wrap--muted" : ""}`}
      >
        <Image
          src={product.image}
          alt={product.imageAlt}
          width={900}
          height={700}
          format="webp"
          loading="lazy"
        />
      </div>
    )
  }
</div>

<style>
  .ps__strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 52vh;
    /* border-bottom: 1px solid var(--color-border); */
    margin-bottom: 5rem;
  }

  .ps__content {
    position: relative;
    overflow: visible;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-lg);
  }

  .ps__ghost {
    position: absolute;
    right: 0;
    bottom: calc(-0.5 * var(--space-lg));
    font-family: var(--font-display);
    font-size: 28vw;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--color-red);
    opacity: 0.08;
    pointer-events: none;
    user-select: none;
  }

  .ps__strip--flip .ps__ghost {
    color: var(--color-gold);
  }

  .ps__name {
    font-size: var(--text-section);
    font-family: var(--font-display);
    color: var(--color-white);
    line-height: 0.95;
  }

  .ps__body {
    max-width: 46ch;
  }

  .ps__stat {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .ps__stat-num {
    font-size: var(--text-product);
    color: var(--color-red);
    line-height: 1;
  }

  .ps__stat-label {
    color: var(--color-grey);
    line-height: 1.4;
  }

  .ps__img-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    height: 60vh;
  }

  .ps__img-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ps__img-wrap--muted :global(img) {
    filter: grayscale(50%);
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    .ps__strip {
      grid-template-columns: 1fr;
      min-height: unset;
    }

    .ps__content {
      order: 0;
      padding: var(--space-md) var(--space-md);
      overflow: hidden;
    }

    .ps__img-wrap {
      height: 55vw;
      order: 1;
    }

    .ps__ghost {
      font-size: 55vw;
    }
  }
</style>
