---
import { Image } from "astro:assets";
import type { AudienceCard } from "@data/audience-cards";
import placeholderImage from "../../../public/images/audience/card-placeholder-audience.jpg";

interface Props {
  card: AudienceCard;
}

const { card } = Astro.props;
---

<a
  href={card.href}
  class={`ac__card${card.tint ? ` ac__card--${card.tint}` : ""}`}
>
  <Image
    src={card.image ?? placeholderImage}
    alt=""
    width={800}
    height={1000}
    format="webp"
    loading="lazy"
  />
  <span class="ac__tint" aria-hidden="true"></span>
  <span class="ac__overlay" aria-hidden="true"></span>
  <div class="ac__content">
    <h3 class="ac__headline display-text">{card.headline}</h3>
    <p class="ac__descriptor">{card.descriptor}</p>
    <span class="ac__cta">Learn More &rarr;</span>
  </div>
  <!-- <div class="ac__overlay"></div> -->
</a>

<style>
  .ac__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 12px;
    text-decoration: none;
  }

  .ac__card :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* .ac__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.2) 55%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
  } */

  .ac__tint {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ac__card--gold .ac__tint {
    background: rgba(201, 168, 76, 0.15);
  }

  .ac__card--grey .ac__tint {
    background: rgba(160, 160, 160, 0.15);
    filter: contrast(1.1);
  }

  .ac__card--red .ac__tint {
    background: rgba(192, 57, 43, 0.15);
  }

  .ac__number {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    color: var(--color-gold);
    z-index: 1;
  }

  .ac__content {
    position: absolute;
    left: var(--space-sm);
    right: var(--space-sm);
    bottom: var(--space-md);
    z-index: 1;
  }

  .ac__headline {
    font-size: var(--text-product);
    color: var(--color-white);
    transition: opacity var(--transition-base);
  }

  .ac__descriptor {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-grey);
    margin-top: var(--space-xs);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .ac__cta {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    margin-top: var(--space-xs);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .ac__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.2) 55%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
    /* opacity: 0; */
    transition: opacity var(--transition-base);
  }

  @media (hover: hover) {
    .ac__card:hover .ac__headline {
      opacity: 0;
    }

    .ac__card:hover .ac__descriptor,
    .ac__card:hover .ac__cta {
      opacity: 1;
    }
  }

  @media (hover: none) {
    .ac__descriptor,
    .ac__cta {
      opacity: 1;
    }
  }
</style>
