---
interface Props {
  id: string;
  label: string;
  name: string;
  type?: 'text' | 'email' | 'textarea' | 'select';
  required?: boolean;
  placeholder?: string;
}

const { id, label, name, type = 'text', required = false, placeholder } = Astro.props;
---

<div class="form-group">
  <label class="form-label" for={id}>{label}</label>
  {type === 'textarea' ? (
    <textarea class="form-textarea" id={id} name={name} placeholder={placeholder} required={required}></textarea>
  ) : type === 'select' ? (
    <select class="form-select" id={id} name={name} required={required}>
      <option value="" disabled selected></option>
      <slot />
    </select>
  ) : (
    <input class="form-input" type={type} id={id} name={name} required={required} />
  )}
</div>
