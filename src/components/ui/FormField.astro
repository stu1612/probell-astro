---
import type { FieldRule } from '@lib/form-validation';

interface Props {
  id: string;
  label: string;
  name: string;
  type?: 'text' | 'email' | 'textarea' | 'select';
  required?: boolean;
  placeholder?: string;
  maxlength?: number;
  rule?: FieldRule;
}

const {
  id,
  label,
  name,
  type = 'text',
  required = false,
  placeholder,
  maxlength = type === 'textarea' ? 2000 : 200,
  rule,
} = Astro.props;

const errorId = `${id}-error`;
const inputType = rule === 'phone' ? 'tel' : type;
---

<div class="form-group">
  <label class="form-label" for={id}>{label}</label>
  {type === 'textarea' ? (
    <textarea class="form-textarea" id={id} name={name} placeholder={placeholder} required={required} maxlength={maxlength} data-rule={rule} aria-describedby={errorId}></textarea>
  ) : type === 'select' ? (
    <select class="form-select" id={id} name={name} required={required} data-rule={rule} aria-describedby={errorId}>
      <option value="" disabled selected></option>
      <slot />
    </select>
  ) : (
    <input class="form-input" type={inputType} id={id} name={name} required={required} maxlength={maxlength} data-rule={rule} aria-describedby={errorId} inputmode={rule === 'phone' ? 'tel' : undefined} autocomplete={rule === 'phone' ? 'tel' : undefined} />
  )}
  <p class="form-error" id={errorId} hidden></p>
</div>
