---
interface Props {
  eyebrow: string;
  headline1: string;
  headline2?: string;
  headline3?: string;
  description?: string;
  image: string;
}

const { eyebrow, headline1, headline2, headline3, description, image } =
  Astro.props;
---

<div class="banner" style={`background-image: url(${image})`}>
  <div class=""></div>
  <div class="banner__text">
    <span class="banner__eyebrow">{eyebrow}</span>
    <div class="banner__headline-group">
      <h2 class="display-text banner__headline">{headline1}</h2>
      <h2 class="display-text banner__headline">{headline2}</h2>
      <h2 class="display-text banner__headline">{headline3}</h2>
    </div>
    {description && <p class="banner__description">{description}</p>}
  </div>
</div>

<style>
  .banner {
    position: relative;
    height: 80vh;
    background-size: cover;
    background-position: 50% 55%;
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
    overflow: hidden;
    border-radius: 4px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    border-radius: var(--radius-image);
  }

  .banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .banner__text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-self: center;
  }

  .banner__eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-white);
    margin-bottom: var(--space-xs);
  }

  .banner__headline {
    font-family: var(--font-display);
    font-size: var(--text-statement);
    color: var(--color-white);
  }

  .banner__headline-group {
    z-index: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .banner__description {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-white);
    opacity: 0.85;
    margin-top: var(--space-sm);
    max-width: 560px;
    line-height: 1.6;
  }

  @media (max-width: 1500px) {
    .banner__headline {
      font-size: var(--text-section);
    }
  }

  @media (max-width: 768px) {
    .banner {
      grid-template-columns: 1fr;
      height: auto;
      min-height: 60vh;
      padding: var(--space-md);
      align-items: end;
    }

    /* hide the empty spacer column on mobile */
    .banner > div:first-child:not(.banner__text) {
      display: none;
    }

    .banner__text {
      width: 100%;
      text-align: center;
    }

    .banner__headline {
      font-size: var(--text-statement);
    }

    .banner__headline-group {
      gap: var(--space-md);
    }

    .banner__description {
      max-width: 100%;
    }
  }
</style>
