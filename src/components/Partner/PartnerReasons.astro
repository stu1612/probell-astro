---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { PartnerReason } from "@data/partners";

interface Props {
  eyebrow: string;
  title: string;
  reasons: PartnerReason[];
  image: ImageMetadata;
  alt: string;
  /* object-position for the crop, e.g. "60% 50%" to keep the product in. */
  imagePosition?: string;
}

const {
  eyebrow,
  title,
  reasons,
  image,
  alt,
  imagePosition = "50% 50%",
} = Astro.props;
---

<section class="pr">
  <div class="container-wide pr__inner">
    <div class="pr__media">
      <Image
        src={image}
        alt={alt}
        width={900}
        format="webp"
        class="pr__image"
        style={`object-position: ${imagePosition};`}
      />
    </div>

    <div class="pr__body">
      <span class="label-text label-text--gold">{eyebrow}</span>
      <h2 class="display-text pr__title">{title}</h2>

      <ol class="pr__list">
        {
          reasons.map((reason, i) => (
            <li class="pr__item">
              <span class="label-text pr__num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="display-text pr__item-title">{reason.title}</h3>
                <p class="font-text pr__item-body">{reason.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .pr {
    background: var(--color-black);
    padding-block: var(--space-xl);
  }

  .pr__inner {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .pr__media {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-md));
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .pr__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pr__title {
    margin-top: var(--space-sm);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-statement-md);
    color: var(--color-white);
  }

  .pr__list {
    margin-top: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .pr__item {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .pr__num {
    color: var(--color-gold);
    padding-top: 0.6em;
  }

  .pr__item-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-product);
    color: var(--color-white);
    line-height: 1;
  }

  .pr__item-body {
    margin-top: var(--space-xs);
    color: var(--color-grey);
  }

  @media (max-width: 1024px) {
    .pr__inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .pr__media {
      position: static;
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 768px) {
    .pr {
      padding-block: var(--space-lg);
    }

    .pr__item {
      grid-template-columns: 2.5rem 1fr;
    }
  }
</style>
