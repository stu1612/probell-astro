---
interface Props {
  eyebrow: string;
  text: string;
}

const { eyebrow, text } = Astro.props;
---

<!-- Light band that breaks the dark run with one plain statement. -->
<section class="pst">
  <div class="container-wide pst__inner">
    <span class="label-text pst__eyebrow">{eyebrow}</span>
    <p class="pst__text">{text}</p>
  </div>
</section>

<style>
  .pst {
    background: var(--color-white);
    padding-block: var(--space-xl);
  }

  .pst__inner {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-xl);
    align-items: baseline;
  }

  .pst__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    /* Brand red passes AA on off-white; --color-red-text doesn't. */
    color: var(--color-red);
  }

  .pst__eyebrow::before {
    content: "";
    width: 3rem;
    height: 1px;
    background: currentColor;
  }

  .pst__text {
    font-family: var(--font-body);
    font-size: var(--text-product);
    line-height: 1.35;
    color: var(--color-black);
    max-width: 34ch;
  }

  @media (max-width: 1024px) {
    .pst__inner {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  @media (max-width: 768px) {
    .pst {
      padding-block: var(--space-lg);
    }
  }
</style>
