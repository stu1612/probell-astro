---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  image: ImageMetadata;
  alt: string;
  eyebrow: string;
  eyebrowTone?: "red" | "gold";
  title: string;
  sub: string;
  facts?: string[];
  /* "statement" for longer headlines that would run past three lines. */
  titleSize?: "hero" | "statement";
}

const {
  id,
  image,
  alt,
  eyebrow,
  eyebrowTone = "red",
  title,
  sub,
  facts = [],
  titleSize = "hero",
} = Astro.props;
---

<div id={id} class="ph">
  <Image
    src={image}
    alt={alt}
    width={1920}
    height={1080}
    format="webp"
    loading="eager"
    class="ph__image"
  />
  <div class="ph__scrim"></div>
  <div class="ph__grain" aria-hidden="true"></div>

  <div class="container-wide ph__content">
    <span class={`label-text label-text--${eyebrowTone} ph__eyebrow`}>
      {eyebrow}
    </span>
    <h1 class={`display-text ph__title ph__title--${titleSize}`}>{title}</h1>
    <p class="font-text ph__sub">{sub}</p>
    {
      facts.length > 0 && (
        <ul class="ph__facts">
          {facts.map((fact) => (
            <li class="label-text">{fact}</li>
          ))}
        </ul>
      )
    }
  </div>
</div>

<style>
  .ph {
    position: relative;
    top: calc(var(--nav-height) * -1);
    margin-bottom: calc(var(--nav-height) * -1);
    min-height: 92svh;
    display: flex;
    align-items: flex-end;
    background: var(--color-black-true);
    overflow: hidden;
  }

  .ph__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Scrim: heaviest at the bottom where the text sits. */
  .ph__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.92) 0%,
      rgba(0, 0, 0, 0.6) 45%,
      rgba(0, 0, 0, 0.35) 100%
    );
  }

  .ph__grain {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    mix-blend-mode: overlay;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  .ph__content {
    position: relative;
    width: 100%;
    padding-top: calc(var(--nav-height) + var(--space-xl));
    padding-bottom: var(--space-lg);
  }

  .ph__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .ph__eyebrow::before {
    content: "";
    width: 3rem;
    height: 1px;
    background: currentColor;
  }

  .ph__title {
    margin-top: var(--space-md);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-hero);
    color: var(--color-white);
    max-width: 14ch;
  }

  .ph__title--statement {
    font-size: var(--text-statement);
    max-width: 18ch;
  }

  .ph__sub {
    margin-top: var(--space-md);
    max-width: 52ch;
    color: var(--color-grey);
  }

  .ph__facts {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(249, 246, 238, 0.15);
  }

  .ph__facts li {
    color: var(--color-white);
  }

  .ph__facts li + li::before {
    content: "/";
    margin-inline: var(--space-sm);
    color: var(--color-gold);
  }

  @media (max-width: 768px) {
    .ph {
      min-height: 88svh;
    }

    .ph__content {
      padding-top: calc(var(--nav-height) + var(--space-lg));
      padding-bottom: var(--space-md);
    }

    .ph__title {
      font-size: var(--text-highlight);
    }

    .ph__title--statement {
      font-size: var(--text-statement);
    }

    .ph__facts {
      margin-top: var(--space-md);
      gap: var(--space-xs) var(--space-md);
    }

    .ph__facts li + li::before {
      content: none;
    }
  }
</style>
