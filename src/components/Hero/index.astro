---
import { Image } from "astro:assets";
---

<section id="hero">
  <div class="hero">
    <Image
      src="/images/hero/hero-main.jpg"
      alt="Probell Nutrition athlete in training"
      width={1920}
      height={1080}
      format="webp"
      loading="eager"
      class="hero__image"
    />
    <div class="hero__overlay-bottom"></div>
    <div class="hero__overlay-right"></div>
  </div>

  <div class="hero__headline">
    <h1 class="headline display-text">
      <span class="headline__line--1">Built</span>
      <span class="headline__line--2">For The</span>
      <span class="headline__line--3">Grind</span>
    </h1>
  </div>
</section>

<style>
  #hero {
    position: relative;
    overflow: hidden;
    height: 120vh;
    top: -72px;
  }

  .hero {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    object-position: 6% center;
  }

  .hero__overlay-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 50%;
    background: linear-gradient(
      180deg,
      rgba(18, 18, 19, 0) 0%,
      rgba(18, 18, 19, 1) 100%
    );
    pointer-events: none;
  }

  .hero__overlay-right {
    position: absolute;
    top: 0;
    right: 0;
    width: 65%;
    height: 100%;
    background: linear-gradient(
      to left,
      rgba(18, 18, 19, 0.95) 0%,
      rgba(18, 18, 19, 0.75) 25%,
      rgba(18, 18, 19, 0.35) 60%,
      rgba(18, 18, 19, 0) 100%
    );
    pointer-events: none;
  }

  .hero__headline {
    position: absolute;
    top: 50%;
    right: 0;
    width: 50%;
    transform: translateY(-50%);
    text-align: left;
    padding: var(--space-lg);
    z-index: 1;
  }

  .headline {
    font-family: var(--font-display);
    color: var(--color-white);
    display: flex;
    flex-direction: column;
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .headline__line--1 {
    font-size: clamp(4rem, 13vw, 16rem);
  }
  .headline__line--2 {
    font-size: clamp(4rem, 9vw, 11rem);
  }
  .headline__line--3 {
    font-size: clamp(4rem, 12vw, 16rem);
  }

  @media (max-width: 1024px) {
    .hero__headline {
      padding: var(--space-md);
      width: 100%;
    }
  }
</style>
