---
import { Image } from "astro:assets";
import homepageHero from "@assets/hero/homepage-hero.jpg";
---

<section id="hero-desktop">
  <div class="hero">
    <picture class="hero__picture">
      <Image
        src={homepageHero}
        alt="Probell Nutrition athlete in training"
        width={1920}
        height={1080}
        format="webp"
        loading="eager"
        class="hero__image"
      />
    </picture>
    <div class="hero__overlay-bottom"></div>
    <div class="hero__grain" aria-hidden="true"></div>
  </div>

  <div class="container-wide hero__headline">
    <span class="label-text label-text--gold hero__eyebrow">
      US-Made · Kettlebell Protein
    </span>
    <h1 class="headline">
      <span class="headline__line--1">Built for</span>
      <span class="headline__line--2">the Grind</span>
    </h1>
    <p class="hero__subline">The only protein you can lift.</p>
  </div>
</section>

<style>
  #hero-desktop {
    position: relative;
    overflow: hidden;
    height: 120vh;
    top: -72px;
    display: none;
  }

  @media (min-width: 768px) {
    #hero-desktop {
      display: block;
    }
  }

  .hero {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .hero__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    object-position: 100% 50%;
  }

  .hero__overlay-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 50%;
    background: linear-gradient(
      180deg,
      rgba(18, 18, 19, 0.01) 0%,
      rgba(18, 18, 19, 1) 100%
    );
    pointer-events: none;
  }

  /* Same grain as PartnerHero, for grit over the photo. */
  .hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    mix-blend-mode: overlay;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  .hero__headline {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    text-align: left;
    z-index: 1;
    filter: drop-shadow(0px 4px 4px rgba(0, 0, 0, 0.25));
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .hero__eyebrow::before {
    content: "";
    width: 3rem;
    height: 1px;
    background: currentColor;
  }

  .headline {
    font-family: var(--font-display);
    /* h1 defaults to bold; Anton ships one weight, so keep it regular. */
    font-weight: 400;
    color: var(--color-white);
    display: flex;
    flex-direction: column;
    line-height: 0.88;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .headline__line--1 {
    font-size: clamp(5rem, 15vw, 10rem);
  }

  .headline__line--2 {
    font-size: clamp(4rem, 15vw, 8rem);
  }

  .hero__subline {
    color: var(--color-white);
    opacity: 0.8;
    margin-top: var(--space-md);
    max-width: 32ch;
    font-size: var(--text-product);
    line-height: 1.2;
  }
</style>
