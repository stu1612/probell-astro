---
import { Image } from "astro:assets";
import homepageHeroMobile from "@assets/hero/homepage-hero-mobile.jpg";
---

<section id="hero-mobile">
  <div class="hero">
    <picture class="hero__picture">
      <Image
        src={homepageHeroMobile}
        alt="Probell Nutrition athlete in training"
        width={1080}
        height={1920}
        format="webp"
        loading="eager"
        class="hero__image"
      />
    </picture>
    <div class="hero__overlay-top"></div>
    <div class="hero__overlay-bottom"></div>
    <h1 class="hero-headline">
      <span class="hero-headline__accent">Built for</span>
      <span class="hero-headline__line">the Grind</span>
    </h1>

    <h3 class="hero-subheadline">
      <span class="hero-subheadline__line">the only</span>
      <span class="hero-subheadline__accent">supplement</span>
      <span class="hero-subheadline__line">you can lift</span>
    </h3>
  </div>
</section>

<style>
  #hero-mobile {
    position: relative;
    overflow: hidden;
    height: 100vh;
    top: -72px;
    display: block;
  }

  @media (min-width: 768px) {
    #hero-mobile {
      display: none;
    }
  }

  .hero {
    position: relative;
    height: 100%;
  }

  .hero__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    object-position: center;
    filter: brightness(0.75);
  }

  .hero__overlay-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 70%;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
  }
  .hero__overlay-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 50%;
    background: linear-gradient(
      180deg,
      rgba(18, 18, 19, 0) 40%,
      rgba(18, 18, 19, 1) 100%
    );
    pointer-events: none;
  }

  .hero-headline {
    position: absolute;
    top: 80px;
    left: 0;
    font-family: var(--font-display);
    color: var(--color-white);
    display: flex;
    flex-direction: column;
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-align: justify;
    padding-left: 23px;
    filter: drop-shadow(0px 4px 4px rgba(0, 0, 0, 0.25));
  }
  .hero-subheadline {
    position: absolute;
    bottom: 5%;
    right: 0;
    font-family: var(--font-display);
    color: var(--color-white);
    display: flex;
    flex-direction: column;
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-align: right;
    padding-right: 23px;
    filter: drop-shadow(0px 4px 4px rgba(0, 0, 0, 0.25));
  }

  .hero-headline__accent {
    font-size: 5rem;
  }

  .hero-headline__line {
    font-size: 2.5rem;
  }

  .hero-subheadline__accent {
    font-size: 3rem;
  }

  .hero-subheadline__line {
    font-size: 1.5rem;
  }

  .hero__grid {
    position: absolute;
    bottom: 10%;
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: repeat(3, auto);
    align-items: center;
    justify-items: center;
    gap: 1rem;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    box-sizing: border-box;
    max-width: calc(100% - (var(--space-md) * 2));
  }

  .hero__grid a {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    transition: color var(--transition-fast);
  }

  .hero__grid a:hover {
    color: var(--color-red);
  }
</style>
