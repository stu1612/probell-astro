---
import ContactForm from "@components/Contact/ContactForm.astro";
---

<section id="contact" class="section section--lg">
  <div class="container">
    <div class="contact__grid">
      <div class="contact__form-wrap">
        <ContactForm />
      </div>
      <div class="contact__content">
        <span class="label-text label-text--red">Partner with Probell</span>
        <h2 class="display-text contact__headline">
          Stock Probell.<br />Be First.
        </h2>
        <p class="contact__subline font-text text-grey">
          Whether you&rsquo;re a gym, distributor, or retailer &mdash; we want
          to hear from you.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  .contact__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.4)),
      url("/images/lifestyle/man-holding-kettlebell.jpg");
    background-size: cover;
    background-position: center;
    height: 100%;
    width: 100%;
    border-radius: var(--radius-image);
    padding: var(--space-md);
  }

  .contact__headline {
    font-size: var(--text-statement);
    color: var(--color-white);
    margin: 0;
  }

  .contact__subline {
    margin: 0;
    max-width: 26ch;
  }

  @media (max-width: 768px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
