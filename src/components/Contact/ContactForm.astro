---
import { CONTACT_SUBJECT } from "@constants/site";
import FormField from "@components/ui/FormField.astro";
const web3formsKey = import.meta.env.WEB3FORMS_KEY ?? "";
---

<div
  id="contact-success"
  class="contact__success label-text"
  style="display: none;"
  aria-live="polite"
>
  Thanks for reaching out. We&rsquo;ll be in touch soon.
</div>

<form
  id="contact-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  novalidate
>
  <input type="hidden" name="access_key" value={web3formsKey} />
  <input type="hidden" name="subject" value={CONTACT_SUBJECT} />
  <input type="hidden" name="redirect" value="false" />
  <input type="checkbox" name="botcheck" style="display: none;" />

  <FormField id="contact-name" label="Full Name" name="name" required={true} />
  <FormField id="contact-business" label="Business Name" name="business" required={true} />
  <FormField id="contact-email" label="Email Address" name="email" type="email" required={true} />
  <FormField id="contact-type" label="I am a…" name="type" type="select" required={true}>
    <option value="Gym">Gym</option>
    <option value="Distributor">Distributor</option>
    <option value="Retailer">Retailer</option>
    <option value="Other">Other</option>
  </FormField>
  <FormField
    id="contact-message"
    label="Message"
    name="message"
    type="textarea"
    placeholder="Tell us about your business and how you'd like to work with Probell."
  />

  <div class="h-captcha" data-captcha="true"></div>

  <p
    id="contact-error"
    class="contact__error label-text"
    style="display: none;"
    aria-live="polite"
  >
    Something went wrong. Please try again or email us directly.
  </p>

  <button type="submit" class="btn-primary contact__submit">
    Get in Touch
  </button>
</form>

<script src="https://web3forms.com/client/script.js" async defer></script>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const success = document.getElementById("contact-success");
  const error = document.getElementById("contact-error");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !success || !error) return;

    error.style.display = "none";

    const data = new FormData(form);

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: data,
      });
      const json = await res.json();

      if (json.success) {
        form.style.display = "none";
        success.style.display = "block";
      } else {
        error.style.display = "block";
      }
    } catch {
      error.style.display = "block";
    }
  });
</script>

<style>
  .contact__success {
    color: var(--color-gold);
    padding: var(--space-lg) 0;
  }

  .contact__error {
    color: var(--color-red);
    margin-bottom: var(--space-sm);
  }

  .contact__submit {
    margin-top: var(--space-sm);
  }

  @media (max-width: 768px) {
    .contact__submit {
      width: 100%;
    }
  }
</style>
