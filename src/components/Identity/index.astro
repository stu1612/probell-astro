---
interface Props {
  headline: string;
  body: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { headline, body, primaryCta, secondaryCta } = Astro.props;
const hasCtas = primaryCta || secondaryCta;
---

<section id="identity">
  <div class="identity__row">
    <div class="identity__left">
      <h4 class="display-text identity__headline">{headline}</h4>
      {
        hasCtas && (
          <div class="identity__ctas">
            {primaryCta && (
              <a href={primaryCta.href} class="btn-primary">
                {primaryCta.label}
              </a>
            )}
            {secondaryCta && (
              <a href={secondaryCta.href} class="btn-secondary">
                {secondaryCta.label}
              </a>
            )}
          </div>
        )
      }
    </div>
    {
      body && (
        <div class="identity__body">
          <p class="font-text">{body}</p>
        </div>
      )
    }
  </div>
</section>

<style>
  .identity__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .identity__row:not(:has(.identity__body)) {
    grid-template-columns: 1fr;
  }

  .identity__left {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    justify-content: space-between;
    height: 100%;
  }

  .identity__headline {
    font-family: var(--font-display);
    font-size: var(--text-highlight);
    color: var(--color-white);
    text-align: center;
  }

  .identity__body {
    height: 100%;
    display: flex;
    align-items: end;
  }

  .identity__body-text {
    font-size: var(--text-body);
    color: var(--color-white);
    line-height: 1.6;
  }

  .identity__ctas {
    display: flex;
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    #identity {
      padding: var(--space-lg) 0;
    }

    .identity__headline {
      text-align: left;
    }
  }

  @media (max-width: 1040px) {
    .identity__row {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      padding: 0 var(--space-md) var(--space-md);
      text-align: center;
    }

    .identity__ctas {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
