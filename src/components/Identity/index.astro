---
interface Props {
  eyebrow?: string;
  headline: string;
  accentText?: string;
  highlightText?: string;
  lead?: string;
  body: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const {
  eyebrow,
  headline,
  accentText,
  highlightText,
  lead,
  body,
  primaryCta,
  secondaryCta,
} = Astro.props;
const hasCtas = primaryCta || secondaryCta;
---

<section id="identity">
  <div class="identity__stack">
    {
      eyebrow && (
        <span class="label-text label-text--gold identity__eyebrow">
          {eyebrow}
        </span>
      )
    }
    <h2 class="display-text identity__headline">
      <span class="identity__headline-main">{headline}</span>
      {accentText && <span class="identity__accent"> {accentText}</span>}
      {
        highlightText && (
          <span class="identity__highlight"> {highlightText}</span>
        )
      }
    </h2>
    {lead && <p class="font-text identity__lead">{lead}</p>}
    {body && <p class="font-text identity__body-text">{body}</p>}
    {
      hasCtas && (
        <div class="identity__ctas">
          {primaryCta && (
            <a href={primaryCta.href} class="btn-primary">
              {primaryCta.label}
            </a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn-secondary">
              {secondaryCta.label}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  /* Centered "statement" layout — deliberate exception per design.md §4 */
  #identity {
    padding: var(--space-xl) 0;
  }

  .identity__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .identity__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .identity__eyebrow::before,
  .identity__eyebrow::after {
    content: "";
    width: 2rem;
    height: 1px;
    background: currentColor;
  }

  .identity__headline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-statement);
    line-height: 0.92;
    color: var(--color-white);
    text-align: center;
    max-width: 18ch;
    text-wrap: balance;
  }

  .identity__accent {
    color: var(--color-white);
    opacity: 0.5;
  }

  .identity__highlight {
    color: var(--color-gold);
  }

  .identity__lead {
    margin-top: var(--space-md);
    max-width: 34ch;
    font-size: var(--text-product);
    line-height: 1.25;
    color: var(--color-white);
    text-wrap: balance;
  }

  .identity__body-text {
    margin-top: var(--space-sm);
    max-width: 60ch;
    color: var(--color-grey);
    line-height: 1.6;
  }

  .identity__ctas {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    margin-top: var(--space-lg);
  }

  @media (max-width: 1280px) {
    .identity__headline {
      display: flex;
      flex-direction: column;
    }

    .identity__ctas {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (max-width: 768px) {
    #identity {
      padding: var(--space-lg) 0;
    }

    .identity__ctas {
      margin-top: var(--space-md);
    }
  }
</style>
