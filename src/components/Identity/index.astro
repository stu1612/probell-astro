---
interface Props {
  headline: string;
  accentText?: string;
  highlightText?: string;
  body: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { headline, accentText, highlightText, body, primaryCta, secondaryCta } =
  Astro.props;
const hasCtas = primaryCta || secondaryCta;
---

<section id="identity">
  <div class="identity__stack">
    <h2 class="display-text identity__headline">
      <span class="identity__headline-main">{headline}</span>
      {accentText && <span class="identity__accent"> {accentText}</span>}
      {
        highlightText && (
          <span class="identity__highlight"> {highlightText}</span>
        )
      }
    </h2>
    {body && <p class="font-text identity__body-text">{body}</p>}
    {
      hasCtas && (
        <div class="identity__ctas">
          {primaryCta && (
            <a href={primaryCta.href} class="btn-primary">
              {primaryCta.label}
            </a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn-secondary">
              {secondaryCta.label}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  /* Centered "statement" layout — deliberate exception per design.md §4 */
  #identity {
    padding: var(--space-xl) 0;
  }

  .identity__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .identity__headline {
    font-family: var(--font-display);
    font-size: var(--text-highlight);
    color: var(--color-white);
    text-align: center;
  }

  .identity__accent {
    color: var(--color-white);
    opacity: 0.5;
  }

  .identity__highlight {
    color: var(--color-gold);
  }

  .identity__body-text {
    font-size: var(--text-body);
    color: var(--color-white);
    line-height: 1.6;
    max-width: 840px;
  }

  .identity__ctas {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
  }

  @media (max-width: 1280px) {
    .identity__headline {
      display: flex;
      flex-direction: column;
    }

    .identity__ctas {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
