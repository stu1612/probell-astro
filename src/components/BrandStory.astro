---
import { Image } from "astro:assets";
import { STATS } from "@data/stats";
---

<section id="emotion" class="container">
  <h2 class="display-text em__headline">
    Just the product your serious members have been waiting for someone to
    stock.
  </h2>
  <!-- ── Stats block ── -->
  <div class="em__stats-section">
    <div class="em__stats-layout">
      <!-- Left anchor -->
      <div class="em__anchor">
        <span class="label-text label-text--red em__eyebrow"
          >Performance Data</span
        >
        <p class="em__anchor-statement display-text">
          The numbers behind the product.
        </p>
        <p class="em__anchor-body font-text text-black">
          Every scoop of Probell is built on a single standard: if it doesn't
          serve the athlete, it doesn't go in.
        </p>
      </div>

      <!-- Stats list -->
      <div class="em__stats-list">
        {
          STATS.map((stat) => (
            <div class="em__stat-row">
              <span
                class={`display-text em__stat-num${stat.accent ? " em__stat-num--red" : ""}`}
              >
                {stat.number}
              </span>
              <div class="em__stat-right">
                <span class="label-text em__stat-label">{stat.label}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ── Image + CTA block ── -->
  <div class="em__cta-section">
    <div class="em__cta-layout">
      <div class="em__cta-img">
        <Image
          src="/images/lifestyle/cpb-gym.jpg"
          alt="Probell products in a gym setting"
          width={780}
          height={580}
          format="webp"
          loading="lazy"
        />
      </div>

      <div class="em__cta-content">
        <h2 class="display-text em__cta-headline">
          Give your members what they've been asking for.
        </h2>
        <p class="em__cta-body font-text text-black">
          Probell is stocked in gyms that take their members seriously. Talk to
          us about wholesale pricing, margins, and display support.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  #emotion {
    background: var(--color-white);
    padding: var(--space-xl) 0;
  }

  .em__headline {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    color: var(--color-black);
    text-align: center;
    padding-bottom: var(--space-2xl);
  }

  /* ── Stats block ── */
  .em__stats-layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .em__anchor {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: sticky;
    top: calc(var(--nav-height) + var(--space-lg));
  }

  .em__eyebrow {
    display: block;
  }

  .em__anchor-statement {
    font-family: var(--font-display);
    font-size: var(--text-section);
    color: var(--color-black);
    line-height: 0.95;
  }

  .em__anchor-body {
    max-width: 28ch;
  }

  /* Stats list */
  .em__stats-list {
    display: flex;
    flex-direction: column;
  }

  .em__stat-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-border);
  }

  .em__stat-row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .em__stat-num {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    color: var(--color-black);
    line-height: 0.9;
  }

  .em__stat-num--red {
    color: var(--color-red);
  }

  .em__stat-right {
    display: flex;
    align-items: center;
  }

  .em__stat-label {
    color: var(--color-grey);
    letter-spacing: 0.12em;
    max-width: 30ch;
  }

  /* ── CTA block ── */
  .em__cta-section {
    padding: var(--space-xl) 0;
  }

  .em__cta-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  .em__cta-img :global(img) {
    width: 100%;
    height: 520px;
    object-fit: cover;
    border-radius: var(--radius-image);
    display: block;
  }

  .em__cta-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .em__cta-eyebrow {
    display: block;
    color: var(--color-red);
  }

  .em__cta-headline {
    font-family: var(--font-display);
    font-size: var(--text-statement);
    color: var(--color-black);
    line-height: 0.95;
  }

  .em__cta-body {
    max-width: 42ch;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .em__stats-layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .em__anchor {
      position: static;
    }

    .em__anchor-body {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .em__cta-layout {
      grid-template-columns: 1fr;
    }

    .em__stat-row {
      grid-template-columns: auto 1fr;
      gap: var(--space-sm);
    }

    .em__stat-num {
      font-size: var(--text-statement);
    }
  }
</style>
