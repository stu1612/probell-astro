---
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  lastUpdated: string;
  intro: string;
}

const { title, description, lastUpdated, intro } = Astro.props;
---

<BaseLayout title={`${title} | Probell Nutrition`} description={description}>
  <main class="legal">
    <div class="legal__container">
      <h1 class="legal__title display-text">{title}</h1>
      <p class="legal__updated label-text">Last updated: {lastUpdated}</p>
      <p class="legal__intro">{intro}</p>
      <slot />
    </div>
  </main>
</BaseLayout>

<style>
  .legal {
    padding: var(--space-2xl) 0 var(--space-xl);
    background-color: var(--color-black);
  }

  .legal__container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  .legal__title {
    color: var(--color-white);
    margin-bottom: var(--space-xs);
  }

  .legal__updated {
    color: var(--color-grey);
    margin-bottom: var(--space-md);
    display: block;
  }

  .legal__intro {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-grey);
    line-height: 1.8;
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }
</style>
