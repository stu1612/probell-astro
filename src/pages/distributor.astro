---
import BaseLayout from "@layouts/BaseLayout.astro";
import FormField from "@components/ui/FormField.astro";
import PartnerHero from "@components/Partner/PartnerHero.astro";
import PartnerStatement from "@components/Partner/PartnerStatement.astro";
import PartnerApply from "@components/Partner/PartnerApply.astro";
import partnerPagesHero from "@assets/partners/partner-pages-hero.jpg";
import { HUBSPOT_FORMS } from "@data/hubspot";
import { CONTACT_EMAIL } from "@constants/site";

const title = "Distributor Program | Probell Nutrition";
const description =
  "We're early, and we're serious about growing right. If you see an opportunity here, we want to hear how you see it.";

const hubspotPortalId = HUBSPOT_FORMS.portalId;
const hubspotFormGuid = HUBSPOT_FORMS.distributor;
---

<BaseLayout title={title} description={description} transparentNav={true}>
  <!-- Gold eyebrow (not red like /sales and /retail) and a deliberately minimal page: positioned as "not handled through automated forms" (see src/docs/brand.md, Partner pages). -->
  <PartnerHero
    id="distributor-hero"
    image={partnerPagesHero}
    alt="Probell Nutrition distribution and logistics"
    eyebrow="Distributor Program"
    eyebrowTone="gold"
    title="Building the Network. Looking for the Right People."
    titleSize="statement"
    sub="We’re early, and we’re serious about growing right. If you see an opportunity here, we want to hear how you see it."
  />

  <PartnerStatement
    eyebrow="Where We Are"
    eyebrowTone="black"
    text="Probell is a US-made kettlebell-shaped protein brand, currently building distribution from the ground up. We’re not pretending to be bigger than we are — we’re looking for distributors who see the same opportunity we do, and want to build something real together."
  />

  <PartnerApply
    eyebrow="Get In Touch"
    eyebrowTone="gold"
    title="Let’s Talk."
    body="We’ll be in touch personally to learn about your business. This isn’t something we handle through automated forms — building the relationship starts with a real conversation."
  >
    <div
      id="distributor-success"
      class="pa-success label-text"
      style="display: none;"
      aria-live="polite"
    >
      Thanks for reaching out. We&rsquo;ll be in touch personally.
    </div>

    <form
      id="distributor-form"
      novalidate
      data-portal-id={hubspotPortalId}
      data-form-guid={hubspotFormGuid}
    >
      <input
        type="checkbox"
        name="botcheck"
        class="pa-honeypot"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <FormField
        id="distributor-business"
        label="Business Name"
        name="businessName"
        required={true}
      />
      <FormField
        id="distributor-name"
        rule="fullName"
        label="Your Name"
        name="fullName"
        required={true}
      />
      <FormField
        id="distributor-email"
        label="Contact Email"
        name="email"
        type="email"
        required={true}
      />
      <FormField id="distributor-phone" label="Phone" name="phone" rule="phone" />

      <div class="form-group">
        <label class="pa-consent">
          <input
            type="checkbox"
            name="consent"
            required
            aria-describedby="distributor-consent-error"
          />
          <span>
            I agree to be contacted by Probell Nutrition regarding my inquiry.
            See our <a href="/legal/privacy">Privacy Policy</a>.
          </span>
        </label>
        <p class="form-error" id="distributor-consent-error" hidden></p>
      </div>

      <p
        id="distributor-error"
        class="pa-error label-text"
        style="display: none;"
        aria-live="polite"
      >
        Something went wrong. Please try again or <a href={`mailto:${CONTACT_EMAIL}`}>email us directly</a>.
      </p>

      <button type="submit" class="btn-primary pa-submit">Get In Touch</button>
    </form>
  </PartnerApply>
</BaseLayout>

<script>
  import {
    submitToHubSpot,
    checkSpamSubmission,
    splitFullName,
  } from "@lib/hubspot";
  import { validateForm, enableLiveValidation } from "@lib/form-validation";

  const CONSENT_TEXT =
    "I agree to be contacted by Probell Nutrition regarding my inquiry.";

  const form = document.getElementById(
    "distributor-form",
  ) as HTMLFormElement | null;
  const success = document.getElementById("distributor-success");
  const error = document.getElementById("distributor-error");
  const renderedAt = Date.now();

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !success || !error) return;

    error.style.display = "none";

    if (!validateForm(form)) {
      enableLiveValidation(form);
      return;
    }

    const portalId = form.dataset.portalId ?? "";
    const formGuid = form.dataset.formGuid ?? "";

    const honeypot =
      (form.elements.namedItem("botcheck") as HTMLInputElement)?.checked ??
      false;

    const spamReason = checkSpamSubmission(honeypot, renderedAt);
    if (spamReason === "honeypot") {
      return;
    }
    if (spamReason === "too-fast") {
      error.style.display = "block";
      return;
    }

    const data = new FormData(form);
    const { firstname, lastname } = splitFullName(
      String(data.get("fullName") ?? ""),
    );

    try {
      const { success: ok } = await submitToHubSpot({
        portalId,
        formGuid,
        consentText: CONSENT_TEXT,
        fields: [
          {
            name: "business_name",
            value: String(data.get("businessName") ?? ""),
          },
          { name: "firstname", value: firstname },
          { name: "lastname", value: lastname },
          { name: "email", value: String(data.get("email") ?? "") },
          { name: "phone", value: String(data.get("phone") ?? "") },
          { name: "partner_type", value: "Distributor" },
        ],
      });

      if (ok) {
        form.style.display = "none";
        success.style.display = "block";
      } else {
        error.style.display = "block";
      }
    } catch {
      error.style.display = "block";
    }
  });
</script>
