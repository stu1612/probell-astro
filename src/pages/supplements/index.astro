---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionWrapper from "@components/SectionWrapper/index.astro";
import SupplementRow from "@components/SupplementRow.astro";
import { PRODUCTS } from "@data/catalog";

const availableProducts = PRODUCTS.filter(
  (product) => product.status === "available",
);

const title = "Supplements | Probell Nutrition";
const description =
  "Whey protein, creatine, and pre-workout built to one standard. No fillers, no shortcuts.";
---

<BaseLayout title={title} description={description} transparentNav={true}>
  <SectionWrapper bg="black">
    <h1 class="sr-only">Supplements</h1>
    {
      availableProducts.map((product, i) => (
        <SupplementRow product={product} loading={i === 0 ? "eager" : "lazy"} />
      ))
    }
  </SectionWrapper>
</BaseLayout>

