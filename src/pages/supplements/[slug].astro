---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProductHero from "@components/ProductDetail/ProductHero.astro";
import ProductStats from "@components/ProductDetail/ProductStats.astro";
import ProductOverview from "@components/ProductDetail/ProductOverview.astro";
import ProductUsage from "@components/ProductDetail/ProductUsage.astro";
import ProductCta from "@components/ProductDetail/ProductCta.astro";
import { PRODUCTS, type Product } from "@data/catalog";

export function getStaticPaths() {
  return PRODUCTS.filter((product) => product.status === "available").map(
    (product) => ({
      params: { slug: product.slug },
      props: { product },
    }),
  );
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

const title = `${product.name} | Probell Nutrition`;
const description = product.description.slice(0, 155).trim();

const leadStat = product.stats[0];

const usageItems = [
  { label: "When to take it", value: product.usage.when },
  { label: "How much", value: product.usage.amount },
  { label: "What to mix with", value: product.usage.mixWith },
];
---

<BaseLayout title={title} description={description} transparentNav={true}>
  <ProductHero product={product} leadStat={leadStat} />
  <ProductStats stats={product.stats} />
  <ProductOverview product={product} />
  <ProductUsage usageItems={usageItems} />
  <ProductCta product={product} />
</BaseLayout>
