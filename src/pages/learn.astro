---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { CATEGORY_PAGES } from "@data/categories";
import SectionWrapper from "@components/SectionWrapper/index.astro";

const title = "Learn | Probell Nutrition";
const description =
  "Understand the supplements behind the brand. Whey protein, creatine, pre-workout, and mass gainer — what they are, who they are for, and why they work.";
---

<BaseLayout title={title} description={description} transparentNav={true}>
  <div id="learn">
    <div class="learn">
      <div class="container">
        <!-- <span class="learn__eyebrow label-text label-text--red">Education</span> -->
        <h1 class="learn__title">Understand<br />the Brand.</h1>
      </div>
    </div>
  </div>
  <SectionWrapper bg="white">
    <div class="container">
      <div class="learn__tab-bar">
        <div class="container">
          <div
            class="learn__tabs"
            role="tablist"
            aria-label="Product categories"
          >
            {
              CATEGORY_PAGES.map((page, i) => (
                <button
                  class={`learn__tab${i === 0 ? " is-active" : ""}`}
                  role="tab"
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls={`panel-${page.slug}`}
                  id={`tab-${page.slug}`}
                >
                  {page.title}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      {
        CATEGORY_PAGES.map((page, i) => (
          <section
            class={`learn__panel${i === 0 ? " is-active" : ""}`}
            id={`panel-${page.slug}`}
            role="tabpanel"
            aria-labelledby={`tab-${page.slug}`}
          >
            <div class="container">
              <div class="learn__content">
                <div class="learn__body">
                  <p class="learn__intro">{page.intro}</p>

                  {page.sections.map((section) => (
                    <div class="learn__section">
                      <h2 class="learn__section-heading">{section.heading}</h2>
                      <p class="learn__section-text">{section.content}</p>
                      {section.stat && (
                        <div class="learn__stat">
                          <span class="learn__stat-value">
                            {section.stat.value}
                          </span>
                          <span class="learn__stat-label">
                            {section.stat.label}
                          </span>
                        </div>
                      )}
                    </div>
                  ))}

                  <a href={page.cta.href} class="btn-primary learn__cta">
                    {page.cta.label}
                  </a>
                </div>

                <aside class="learn__aside">
                  <div class="learn__display-image">
                    <Image
                      src={page.hero.image}
                      alt={page.hero.alt}
                      width={1440}
                      height={648}
                      format="webp"
                      loading={i === 0 ? "eager" : "lazy"}
                      class="display-image"
                    />
                  </div>
                  <p class="learn__statement">{page.statement}</p>
                </aside>
              </div>
            </div>
          </section>
        ))
      }
    </div>
  </SectionWrapper>
</BaseLayout>

<style>
  #learn {
    position: relative;
    height: 70vh;
    top: -72px;
  }

  .learn {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(to bottom, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
      url("/images/lifestyle/shelf-display.jpg");
    background-size: cover;
    background-position: 50% 40%;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .learn__title {
    font-family: var(--font-display);
    font-size: var(--text-highlight);
    color: var(--color-white);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin: 0;
  }

  .learn__display-image {
    margin-bottom: var(--space-md);
    border-radius: 20px;
    overflow: hidden;
    height: 50vh;
  }

  .display-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Tab bar */
  /* .learn__tab-bar {
    border-bottom: 1px solid var(--color-border);
  } */

  .learn__tabs {
    display: flex;
    gap: var(--space-xs);
    overflow-x: auto;
    padding: var(--space-sm) 0;
  }

  .learn__tab {
    font-family: var(--font-body);
    font-size: var(--text-label);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-white);
    background: var(--color-black);
    border: none;
    border-radius: 999px;
    padding: var(--space-xs) var(--space-md);
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .learn__tab:hover {
    opacity: 0.7;
  }

  .learn__tab.is-active {
    background: var(--color-red);
    color: var(--color-white);
    opacity: 1;
  }

  /* Tab panels */
  .learn__panel {
    display: none;
  }

  .learn__panel.is-active {
    display: block;
  }

  /* Two-column content grid */
  .learn__content {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-xl);
    padding: var(--space-xl) 0 var(--space-2xl);
    align-items: start;
  }

  /* Left — body column */
  .learn__intro {
    font-family: var(--font-display);
    font-size: var(--text-product);
    color: var(--color-black);
    line-height: 1.8;
    padding-bottom: var(--space-md);
    margin: 0;
  }

  .learn__section {
    border-top: 1px solid var(--color-border);
    padding: var(--space-md) 0;
  }

  .learn__section-heading {
    font-family: var(--font-display);
    font-size: var(--text-product);
    color: var(--color-black);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin: 0 0 var(--space-sm);
  }

  .learn__section-text {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-grey);
    line-height: 1.8;
    margin: 0;
  }

  /* Stat block */
  .learn__stat {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    /* border-top: 1px solid var(--color-border); */
  }

  .learn__stat-value {
    font-family: var(--font-display);
    font-size: var(--text-section);
    color: var(--color-black);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .learn__stat-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    color: var(--color-grey);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .learn__cta {
    display: inline-block;
    margin-top: var(--space-md);
  }

  /* Right — statement column */
  .learn__aside {
    position: sticky;
    top: var(--space-lg);
    /* padding-top: var(--space-md);
    border-top: 1px solid var(--color-border); */
  }

  .learn__statement {
    font-family: var(--font-display);
    font-size: var(--text-section);
    color: var(--color-black);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .learn__content {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .learn__aside {
      position: static;
      order: -1;
    }

    .learn__hero {
      height: 40vh;
    }

    .learn__tab {
      padding: var(--space-sm);
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".learn__tab");
  const panels = document.querySelectorAll<HTMLElement>(".learn__panel");

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        t.classList.remove("is-active");
        t.setAttribute("aria-selected", "false");
      });
      panels.forEach((p) => p.classList.remove("is-active"));

      tab.classList.add("is-active");
      tab.setAttribute("aria-selected", "true");
      panels[i].classList.add("is-active");
    });
  });
</script>
