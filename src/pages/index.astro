---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero/index.astro";
import AudienceCards from "@components/AudienceCards/index.astro";
import Identity from "@components/Identity/index.astro";
import Contact from "@components/Contact/index.astro";
import SectionWrapper from "@components/SectionWrapper/index.astro";
import ProductStrips from "@components/ProductStrips/index.astro";
import BrandStory from "@components/BrandStory/index.astro";
---

<BaseLayout
  title="Probell Nutrition | Built for the Grind"
  description="The kettlebell-shaped protein built for people who already show up. B2B enquiries welcome."
  transparentNav={true}
>
  <main>
    <Hero />
    <SectionWrapper bg="black">
      <Identity
        headline="Stock the brand that belongs in your gym."
        accentText="One Standard."
        highlightText="No Compromise."
        body="The container gets their attention. The formula keeps them coming back. Give your members both.  Probell was built for people who don't need motivation — they just need fuel. No shortcuts, no fillers, no compromise. The kind of product your serious members have been waiting for someone to stock."
        primaryCta={{ label: "View Products → ", href: "/supplements" }}
      />
      <ProductStrips />
      <AudienceCards />
    </SectionWrapper>
    <SectionWrapper bg="white">
      <BrandStory />
    </SectionWrapper>
    <Contact />
    <SectionWrapper bg="black" />
  </main>
</BaseLayout>
