---
import BaseLayout from "@layouts/BaseLayout.astro";
import FormField from "@components/ui/FormField.astro";
import PartnerHero from "@components/Partner/PartnerHero.astro";
import PartnerReasons from "@components/Partner/PartnerReasons.astro";
import PartnerStatement from "@components/Partner/PartnerStatement.astro";
import PartnerSteps from "@components/Partner/PartnerSteps.astro";
import PartnerApply from "@components/Partner/PartnerApply.astro";
import partnerPagesHero from "@assets/partners/partner-pages-hero.jpg";
import productInHand from "@assets/audience/sales.jpg";
import { HUBSPOT_FORMS } from "@data/hubspot";
import { RETAIL_FACTS, RETAIL_REASONS, RETAIL_STEPS } from "@data/partners";
import { CONTACT_EMAIL } from "@constants/site";

const title = "Retailer Program | Probell Nutrition";
const description =
  "Tell us what you need — we'll give you a straight answer, fast. Request wholesale pricing to stock Probell Nutrition.";

const hubspotPortalId = HUBSPOT_FORMS.portalId;
const hubspotFormGuid = HUBSPOT_FORMS.retailer;
---

<BaseLayout title={title} description={description} transparentNav={true}>
  <PartnerHero
    id="retail-hero"
    image={partnerPagesHero}
    alt="Probell Nutrition retail display"
    eyebrow="Retailer Program"
    title="You’ve Got Enough to Manage."
    sub="Tell us what you need — we’ll give you a straight answer, fast."
    facts={RETAIL_FACTS}
  />

  <PartnerReasons
    eyebrow="Why Stock Probell"
    title="Worth the Shelf Space."
    reasons={RETAIL_REASONS}
    image={productInHand}
    alt="Athlete lifting a Probell kettlebell-shaped pre-workout container"
    imagePosition="58% 50%"
  />

  <PartnerStatement
    eyebrow="Wholesale Pricing"
    text="Wholesale pricing is shared directly with approved retailers. Submit a request below and we’ll get back to you personally — no account, no login, no waiting on hold."
  />

  <PartnerSteps eyebrow="The Process" title="How It Works" steps={RETAIL_STEPS} />

  <PartnerApply
    eyebrow="Request Pricing"
    title="Let’s Talk Stocking Probell."
    body="Tell us about your business and what you’re looking for — we’ll follow up directly with wholesale pricing."
  >
    <div
      id="retail-success"
      class="pa-success label-text"
      style="display: none;"
      aria-live="polite"
    >
      Thanks for reaching out. We read every request personally — we'll be
      in touch.
    </div>

    <form
      id="retail-form"
      novalidate
      data-portal-id={hubspotPortalId}
      data-form-guid={hubspotFormGuid}
    >
      <input
        type="checkbox"
        name="botcheck"
        class="pa-honeypot"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <FormField
        id="retail-business"
        label="Business Name"
        name="businessName"
        required={true}
      />
      <FormField
        id="retail-name"
        rule="fullName"
        label="Your Name"
        name="fullName"
        required={true}
      />
      <FormField
        id="retail-email"
        label="Email"
        name="email"
        type="email"
        required={true}
      />
      <FormField id="retail-phone" label="Phone" name="phone" rule="phone" />
      <FormField
        id="retail-message"
        rule="message"
        label="Tell us about your business and what you're looking for"
        name="inquiryMessage"
        type="textarea"
        required={true}
      />

      <div class="form-group">
        <label class="pa-consent">
          <input
            type="checkbox"
            name="consent"
            required
            aria-describedby="retail-consent-error"
          />
          <span>
            I agree to be contacted by Probell Nutrition regarding my request.
            See our <a href="/legal/privacy">Privacy Policy</a>.
          </span>
        </label>
        <p class="form-error" id="retail-consent-error" hidden></p>
      </div>

      <p
        id="retail-error"
        class="pa-error label-text"
        style="display: none;"
        aria-live="polite"
      >
        Something went wrong. Please try again or <a href={`mailto:${CONTACT_EMAIL}`}>email us directly</a>.
      </p>

      <button type="submit" class="btn-primary pa-submit">Submit Request</button>
    </form>
  </PartnerApply>
</BaseLayout>

<script>
  import {
    submitToHubSpot,
    checkSpamSubmission,
    splitFullName,
  } from "@lib/hubspot";
  import { validateForm, enableLiveValidation } from "@lib/form-validation";

  const CONSENT_TEXT =
    "I agree to be contacted by Probell Nutrition regarding my request.";

  const form = document.getElementById("retail-form") as HTMLFormElement | null;
  const success = document.getElementById("retail-success");
  const error = document.getElementById("retail-error");
  const renderedAt = Date.now();

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !success || !error) return;

    error.style.display = "none";

    if (!validateForm(form)) {
      enableLiveValidation(form);
      return;
    }

    const portalId = form.dataset.portalId ?? "";
    const formGuid = form.dataset.formGuid ?? "";

    const honeypot =
      (form.elements.namedItem("botcheck") as HTMLInputElement)?.checked ??
      false;

    const spamReason = checkSpamSubmission(honeypot, renderedAt);
    if (spamReason === "honeypot") {
      return;
    }
    if (spamReason === "too-fast") {
      error.style.display = "block";
      return;
    }

    const data = new FormData(form);
    const { firstname, lastname } = splitFullName(
      String(data.get("fullName") ?? ""),
    );

    try {
      const { success: ok } = await submitToHubSpot({
        portalId,
        formGuid,
        consentText: CONSENT_TEXT,
        fields: [
          {
            name: "business_name",
            value: String(data.get("businessName") ?? ""),
          },
          { name: "firstname", value: firstname },
          { name: "lastname", value: lastname },
          { name: "email", value: String(data.get("email") ?? "") },
          { name: "phone", value: String(data.get("phone") ?? "") },
          {
            name: "inquiry_message",
            value: String(data.get("inquiryMessage") ?? ""),
          },
          { name: "partner_type", value: "Retailer" },
        ],
      });

      if (ok) {
        form.style.display = "none";
        success.style.display = "block";
      } else {
        error.style.display = "block";
      }
    } catch {
      error.style.display = "block";
    }
  });
</script>
