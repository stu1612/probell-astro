---
import BaseLayout from "@layouts/BaseLayout.astro";
import FormField from "@components/ui/FormField.astro";
import PartnerHero from "@components/Partner/PartnerHero.astro";
import PartnerReasons from "@components/Partner/PartnerReasons.astro";
import PartnerSteps from "@components/Partner/PartnerSteps.astro";
import PartnerApply from "@components/Partner/PartnerApply.astro";
import partnerPagesHero from "@assets/partners/partner-pages-hero.jpg";
import partnerCta from "@assets/partners/partner-cta.jpg";
import { HUBSPOT_FORMS } from "@data/hubspot";
import { SALES_FACTS, SALES_REASONS, SALES_STEPS } from "@data/partners";
import { CONTACT_EMAIL } from "@constants/site";

const title = "Sales Partner Program | Probell Nutrition";
const description =
  "Probell partners aren't chosen for experience — they're chosen for conviction. Apply to become a Sales Partner.";

const hubspotPortalId = HUBSPOT_FORMS.portalId;
const hubspotFormGuid = HUBSPOT_FORMS.sales;
---

<BaseLayout title={title} description={description} transparentNav={true}>
  <PartnerHero
    id="sales-hero"
    image={partnerPagesHero}
    alt="Probell Nutrition sales partner in the field"
    eyebrow="Sales Partner Program"
    title="We’re Not Looking for Salespeople."
    sub="Probell partners aren’t chosen for experience — they’re chosen for conviction. If you already live this, we want to hear from you."
    facts={SALES_FACTS}
  />

  <PartnerReasons
    eyebrow="Why Probell"
    title="Something Worth Carrying."
    reasons={SALES_REASONS}
    image={partnerCta}
    alt="Athlete holding a Probell kettlebell-shaped protein container"
    imagePosition="50% 35%"
  />

  <PartnerSteps eyebrow="The Process" title="How It Works" steps={SALES_STEPS} />

  <PartnerApply
    eyebrow="Apply"
    title="Tell Us Why Probell."
    body="We’re building our partner network from the ground up. Tell us where you want to sell — you could be the first Probell partner in your area."
  >
    <div
      id="sales-success"
      class="pa-success label-text"
      style="display: none;"
      aria-live="polite"
    >
      Thanks for applying. We read every application personally — we'll be
      in touch.
    </div>

    <form
      id="sales-form"
      novalidate
      data-portal-id={hubspotPortalId}
      data-form-guid={hubspotFormGuid}
    >
      <input
        type="checkbox"
        name="botcheck"
        class="pa-honeypot"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <FormField
        id="sales-name"
        rule="fullName"
        label="Full Name"
        name="fullName"
        required={true}
      />
      <FormField
        id="sales-email"
        label="Email"
        name="email"
        type="email"
        required={true}
      />
      <FormField id="sales-phone" label="Phone" name="phone" rule="phone" />
      <FormField
        id="sales-region"
        label="Where do you want to sell?"
        name="regionInterest"
        required={true}
      />
      <FormField
        id="sales-event"
        label="Any event you'd like to sell at?"
        name="eventInterest"
      />
      <FormField
        id="sales-why"
        rule="message"
        label="Why Probell?"
        name="inquiryMessage"
        type="textarea"
        required={true}
      />
      <FormField
        id="sales-heard"
        label="How did you hear about us?"
        name="howHeard"
      />

      <div class="form-group">
        <label class="pa-consent">
          <input
            type="checkbox"
            name="consent"
            required
            aria-describedby="sales-consent-error"
          />
          <span>
            I agree to be contacted by Probell Nutrition regarding my
            application. See our <a href="/legal/privacy">Privacy Policy</a>.
          </span>
        </label>
        <p class="form-error" id="sales-consent-error" hidden></p>
      </div>

      <p
        id="sales-error"
        class="pa-error label-text"
        style="display: none;"
        aria-live="polite"
      >
        Something went wrong. Please try again or <a href={`mailto:${CONTACT_EMAIL}`}>email us directly</a>.
      </p>

      <button type="submit" class="btn-primary pa-submit">Apply Now</button>
    </form>
  </PartnerApply>
</BaseLayout>

<script>
  import {
    submitToHubSpot,
    checkSpamSubmission,
    splitFullName,
  } from "@lib/hubspot";
  import { validateForm, enableLiveValidation } from "@lib/form-validation";

  const CONSENT_TEXT =
    "I agree to be contacted by Probell Nutrition regarding my application.";

  const form = document.getElementById("sales-form") as HTMLFormElement | null;
  const success = document.getElementById("sales-success");
  const error = document.getElementById("sales-error");
  const renderedAt = Date.now();

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !success || !error) return;

    error.style.display = "none";

    if (!validateForm(form)) {
      enableLiveValidation(form);
      return;
    }

    const portalId = form.dataset.portalId ?? "";
    const formGuid = form.dataset.formGuid ?? "";

    const honeypot =
      (form.elements.namedItem("botcheck") as HTMLInputElement)?.checked ??
      false;

    const spamReason = checkSpamSubmission(honeypot, renderedAt);
    if (spamReason === "honeypot") {
      return;
    }
    if (spamReason === "too-fast") {
      error.style.display = "block";
      return;
    }

    const data = new FormData(form);
    const { firstname, lastname } = splitFullName(
      String(data.get("fullName") ?? ""),
    );

    try {
      const { success: ok } = await submitToHubSpot({
        portalId,
        formGuid,
        consentText: CONSENT_TEXT,
        fields: [
          { name: "firstname", value: firstname },
          { name: "lastname", value: lastname },
          { name: "email", value: String(data.get("email") ?? "") },
          { name: "phone", value: String(data.get("phone") ?? "") },
          {
            name: "region_interest",
            value: String(data.get("regionInterest") ?? ""),
          },
          {
            name: "event_interest",
            value: String(data.get("eventInterest") ?? ""),
          },
          {
            name: "inquiry_message",
            value: String(data.get("inquiryMessage") ?? ""),
          },
          { name: "how_heard", value: String(data.get("howHeard") ?? "") },
          { name: "partner_type", value: "Sales Partner" },
        ],
      });

      if (ok) {
        form.style.display = "none";
        success.style.display = "block";
      } else {
        error.style.display = "block";
      }
    } catch {
      error.style.display = "block";
    }
  });
</script>
